{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lab4-kpis.github.io/kpis/schemas/measurement.schema.json",
  "title": "Lab4 KPI measurement batch",
  "type": "array",
  "minItems": 1,
  "maxItems": 10,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["kpi_id", "date", "env", "value", "run_id"],
    "properties": {
      "kpi_id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$", "maxLength": 64 },
      "date": { "type": "string", "format": "date" },
      "env": { "enum": ["dev", "qa", "prod"] },
      "value": { "type": "number" },
      "run_id": { "type": "string", "format": "uuid" }
    }
  }
}
